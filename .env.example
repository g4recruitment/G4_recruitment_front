# Copiar a .env (gitignored). Las mismas tres variables van en Vercel:
# Settings -> Environment Variables, scope Production (y Preview si se usa).
# Vite las hornea en el build: si cambian, hay que redeployar.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# SIN el sufijo /api: lib/api.ts lo agrega. (Lo tolera igual, pero este es el
# valor canónico. El backend responde en <host>/api/...)
VITE_API_URL=https://g4-recruitment-api.onrender.com
